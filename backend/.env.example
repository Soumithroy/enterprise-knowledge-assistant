# Copy to backend/.env and adjust
APP_NAME=Enterprise Knowledge Assistant
ENVIRONMENT=development

# SQLite (default) or PostgreSQL
DATABASE_URL=sqlite:///./knowledge_assistant.db
# DATABASE_URL=postgresql+psycopg2://eka:eka@localhost:5432/eka

# Embeddings: sentence-transformers | hashing (offline, no model download)
EMBEDDING_BACKEND=sentence-transformers
EMBEDDING_MODEL=all-MiniLM-L6-v2

# LLM: ollama | openai | extractive (no LLM)
LLM_PROVIDER=ollama
OLLAMA_MODEL=llama3.2
OLLAMA_HOST=http://localhost:11434
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

SIMILARITY_THRESHOLD=0.35
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
